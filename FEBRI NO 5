# DATA KAMAR
kamar = [
    {"id": "A01", "status": "Kosong"},
    {"id": "A02", "status": "Terisi"},
    {"id": "A03", "status": "Kosong"}
]

# DATA PENGHUNI
penghuni = [
    {"id": "P001", "nama": "Andi"},
    {"id": "P002", "nama": "Budi"},
    {"id": "P003", "nama": "Citra"}
]

# DATA PENYEWAAN
penyewaan = [
    {
        "nama": "Andi",
        "kamar": "A02",
        "tanggal": "2026-11-01",
        "biaya": 500000,
        "status": "Aktif"
    }
]


# FUNGSI TAMBAH PENYEWAAN
def tambah_penyewaan():

    print("\n=== TAMBAH PENYEWAAN ===")

    nama = input("Nama penghuni: ")

    # CEK PENGHUNI
    ada = False

    for p in penghuni:
        if p["nama"].lower() == nama.lower():
            ada = True

    if ada == False:
        print("Penghuni tidak ditemukan!")
        return

    # MENAMPILKAN KAMAR
    print("\nDAFTAR KAMAR")

    for k in kamar:
        print(k["id"], "-", k["status"])

    nomor = input("Pilih kamar: ").upper()

    # CEK KAMAR
    tersedia = False

    for k in kamar:
        if k["id"] == nomor:
            if k["status"] == "Kosong":
                tersedia = True

    if tersedia == False:
        print("Kamar tidak tersedia!")
        return

    # INPUT TANGGAL DAN BIAYA
    tanggal = input("Tanggal sewa: ")

    try:
        biaya = int(input("Biaya per bulan: Rp"))

        if biaya <= 0:
            print("Biaya harus lebih dari nol!")
            return

    except ValueError:
        print("Input biaya harus angka!")
        return

    # MENAMBAHKAN PENYEWAAN
    penyewaan.append({
        "nama": nama,
        "kamar": nomor,
        "tanggal": tanggal,
        "biaya": biaya,
        "status": "Aktif"
    })

    # MENGUBAH STATUS KAMAR
    for k in kamar:
        if k["id"] == nomor:
            k["status"] = "Terisi"

    print("Penyewaan berhasil ditambahkan!")


# FUNGSI LIHAT PENYEWAAN
def lihat_penyewaan():

    print("\n=== DAFTAR PENYEWAAN ===")

    if len(penyewaan) == 0:
        print("Belum ada penyewaan!")
        return

    for s in penyewaan:
        if s["status"] == "Aktif":
            print("----------------------")
            print("Nama    :", s["nama"])
            print("Kamar   :", s["kamar"])
            print("Tanggal :", s["tanggal"])
            print("Biaya   : Rp", s["biaya"])
            print("Status  :", s["status"])


# MENU UTAMA
while True:

    print("\n=== SISTEM MANAJEMEN KOS ===")
    print("1. Tambah Penyewaan")
    print("2. Lihat Penyewaan")
    print("3. Keluar")

    pilihan = input("Pilih menu: ")

    if pilihan == "1":
        tambah_penyewaan()

    elif pilihan == "2":
        lihat_penyewaan()

    elif pilihan == "3":
        print("Program selesai!")
        break

    else:
        print("Pilihan tidak valid!")

