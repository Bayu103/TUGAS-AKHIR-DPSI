def tambah_kamar():
    print("\n=== TAMBAH KAMAR ===")

    id_kamar = input("Masukkan ID Kamar: ").strip().upper()

    # VALIDASI ID
    for kamar in data_kamar:
        if kamar["id"] == id_kamar:
            print("ID Kamar sudah digunakan!")
            return

    nomor = input("Masukkan Nomor Kamar: ")
    tipe = input("Masukkan Tipe Kamar: ")

    # VALIDASI HARGA
    try:
        harga = int(input("Masukkan Harga Sewa: Rp"))

        if harga <= 0:
            print("Harga harus lebih dari 0!")
            return

    except ValueError:
        print("Harga harus berupa angka!")
        return

    # MEMBUAT DATA KAMAR BARU
    kamar_baru = {
        "id": id_kamar,
        "nomor": nomor,
        "tipe": tipe,
        "harga": harga,
        "status": "Kosong"
    }

    data_kamar.append(kamar_baru)

    print("Kamar berhasil ditambahkan!")


#DAFTAR KAMAR
def tampilkan_kamar():
    print("\n=== DAFTAR SELURUH KAMAR ===")

    if len(data_kamar) == 0:
        print("Belum ada data kamar.")

    else:
        for kamar in data_kamar:
            print("----------------------------")
            print("ID Kamar    :", kamar["id"])
            print("Nomor Kamar :", kamar["nomor"])
            print("Tipe Kamar  :", kamar["tipe"])
            print("Harga Sewa  : Rp", kamar["harga"])
            print("Status      :", kamar["status"])

#cari kamar dari id
def cari_kamar():
    print("\n=== CARI KAMAR ===")

    id_kamar = input("Masukkan ID Kamar: ").strip().upper()

    for kamar in data_kamar:
        if kamar["id"] == id_kamar:

            print("\nKamar ditemukan!")
            print("----------------------------")
            print("ID Kamar    :", kamar["id"])
            print("Nomor Kamar :", kamar["nomor"])
            print("Tipe Kamar  :", kamar["tipe"])
            print("Harga Sewa  : Rp", kamar["harga"])
            print("Status      :", kamar["status"])

            return

    print("Kamar tidak ditemukan!")

#status kamar

def status_kamar():
    print("\n=== STATUS KAMAR ===")

    if len(data_kamar) == 0:
        print("Belum ada data kamar.")

    else:
        for kamar in data_kamar:
            print(
                "Kamar", kamar["nomor"],
                "-", kamar["status"]
            )


#tampilan manajemen kamar

def menu_kamar():

    while True:
        print("\n============================")
        print("     MANAJEMEN KAMAR KOS")
        print("============================")
        print("1. Tambah Kamar")
        print("2. Lihat Daftar Kamar")
        print("3. Cari Kamar")
        print("4. Status Kamar")
        print("5. Kembali")

        pilihan = input("Pilih Menu: ")

        if pilihan == "1":
            tambah_kamar()

        elif pilihan == "2":
            tampilkan_kamar()

        elif pilihan == "3":
            cari_kamar()

        elif pilihan == "4":
            status_kamar()

        elif pilihan == "5":
            print("Kembali ke menu utama.")
            break

        else:
            print("Pilihan tidak valid!")

menu_kamar()
