        "status": "kosong"
    }
]


def tampilkan_kamar():
    print("\nDAFTAR KAMAR")

    for kamar in data_kamar:
        print("----------------------")
        print("ID Kamar :", kamar["id"])
        print("Tipe     :", kamar["tipe"])
        print("Harga    : Rp", kamar["harga"])
        print("Fasilitas:", kamar["fasilitas"])
        print("Status   :", kamar["status"])


def edit_kamar():
    print("\nEDIT KAMAR")

    id_kamar = input("Masukkan ID kamar: ")

    kamar = None

    for data in data_kamar:
        if data["id"] == id_kamar:
            kamar = data
            break

    if kamar is None:
        print("Kamar tidak ditemukan!")
        return

    print("\nData kamar sebelumnya:")
    print(kamar)

    tipe_baru = input("Masukkan tipe kamar baru: ")
    fasilitas_baru = input("Masukkan fasilitas baru: ")

    try:
        harga_baru = int(input("Masukkan harga baru: "))

        if harga_baru <= 0:
            print("Harga harus lebih dari 0!")
            return

    except ValueError:
        print("Harga harus berupa angka!")
        return

    kamar["tipe"] = tipe_baru
    kamar["fasilitas"] = fasilitas_baru
    kamar["harga"] = harga_baru

    print("\nData kamar berhasil diperbarui!")


def hapus_kamar():
    print("\nHAPUS KAMAR")

    id_kamar = input("Masukkan ID kamar: ")

    kamar = None

    for data in data_kamar:
        if data["id"] == id_kamar:
            kamar = data
            break

    if kamar is None:
        print("Kamar tidak ditemukan!")
        return

    if kamar["status"] == "terisi":
        print("Kamar masih ditempati!")
        print("Kamar tidak dapat dihapus.")
        return

    print("\nData kamar yang akan dihapus:")
    print(kamar)

    konfirmasi = input(
        "Yakin ingin menghapus kamar? (y/n): "
    ).lower()

    if konfirmasi == "y":
        data_kamar.remove(kamar)
        print("Kamar berhasil dihapus!")
    else:
        print("Penghapusan dibatalkan!")


while True:
    print("\nSISTEM MANAJEMEN KAMAR KOS")
    print("1. Lihat Daftar Kamar")
    print("2. Edit Kamar")
    print("3. Hapus Kamar")
    print("4. Keluar")

    pilihan = input("Pilih menu (1-4): ")

    if pilihan == "1":
        tampilkan_kamar()

    elif pilihan == "2":
        edit_kamar()

    elif pilihan == "3":
        hapus_kamar()

    elif pilihan == "4":
        print("Terima kasih!")
        break

    else:
        print("Pilihan tidak valid!")
